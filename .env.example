# ─────────────────────────────────────────────────────────────
# cre8tor environment configuration
# Copy to .env.local and fill in. All values are optional — the app
# runs in a fully-featured DEMO mode when keys are absent.
# ─────────────────────────────────────────────────────────────

# --- AI (powers the chat, voice writing, analysis, interview) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model id used for generation (defaults to a current Claude model)
CRE8TOR_MODEL=claude-sonnet-5

# --- AI video (Higgsfield) ---
# Powers Video Studio + UGC Video. Get an API key from the Higgsfield
# dashboard. Without it, the studio plays a full in-browser preview instead.
# Format: "KEY_ID:KEY_SECRET"
HF_CREDENTIALS=
# ...or provide the two halves separately:
HF_API_KEY=
HF_API_SECRET=
# Alternatively render via a locally-authenticated `higgsfield` CLI
# (run `higgsfield auth login` first), instead of the API key:
HIGGSFIELD_USE_CLI=
# Optional: point the render provider at a custom endpoint/model
VIDEO_API_URL=

# --- Social connections (optional real OAuth) ---
# When absent, connections use a simulated demo handshake.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Live publishing tokens (optional) ---
# When set, the Publish button posts for real; otherwise it simulates.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
X_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Billing (optional) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
