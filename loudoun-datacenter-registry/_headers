# Response headers for Netlify and Cloudflare Pages.
#
# Both read this file from the publish directory, which for this project is
# this folder — see netlify.toml, and "Deploying" in README.md. GitHub Pages
# ignores it entirely, which is one of several reasons this project is not
# deployed there.
#
# ---------------------------------------------------------------------------
# BEFORE YOU CONNECT SUPABASE, READ THIS
#
# The Content-Security-Policy below lists every host the site is allowed to
# talk to. It does NOT yet include a Supabase project, because none is
# configured. The moment you fill in SUPABASE_URL in js/config.js you must add
# that same origin to `connect-src` and `img-src` here, or the browser will
# block every request to it and the site will look broken with no error a
# visitor can understand.
#
# Add it in both places, e.g. for https://abcdefgh.supabase.co:
#     connect-src ... https://abcdefgh.supabase.co;
#     img-src     ... https://abcdefgh.supabase.co;
#
# connect-src covers the REST and auth calls; img-src covers report photos
# served from storage.
# ---------------------------------------------------------------------------

/*
  # The site has no inline <script> blocks at all, so scripts are restricted to
  # this origin with no escape hatch. That is the directive that actually
  # matters: it means an injected <script> cannot run even if one somehow
  # reaches the page.
  #
  # style-src does need 'unsafe-inline' — there are inline style attributes in
  # the markup, and the map's style swatches are built as inline background
  # images. The risk from that is far lower, and removing it would mean
  # hashing every one.
  #
  # The four tile hosts are the basemap switcher's; nominatim is the address
  # search, which is only ever called on an explicit button press.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://basemaps.cartocdn.com https://server.arcgisonline.com https://basemap.nationalmap.gov; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

  # Nobody should be framing a reporting form. Duplicated from frame-ancestors
  # for the browsers that still only honour this one.
  X-Frame-Options: DENY

  # Stops a browser guessing that an uploaded file is something executable.
  X-Content-Type-Options: nosniff

  # A report page URL says which report is being read. Send the origin only.
  Referrer-Policy: strict-origin-when-cross-origin

  # The site asks for geolocation on an explicit button press and nothing else.
  # Everything else is refused outright, including for any embedded frame.
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()

  # Two years, and only after you are sure the domain will stay on HTTPS.
  # Uncomment when you are.
  # Strict-Transport-Security: max-age=63072000; includeSubDomains

# ---------------------------------------------------------------------------
# Caching
#
# The HTML must never be cached hard: it is how a visitor picks up a change.
# The vendored libraries and fonts are versioned by content and never edited
# in place, so they can be cached for a year.
# ---------------------------------------------------------------------------

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The facility snapshot and the news feed are refreshed periodically. An hour
# is short enough that a refresh shows up the same day and long enough that
# the map isn't re-fetching 500 KB on every page view.
/data/*
  Cache-Control: public, max-age=3600
